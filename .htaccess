# Plataforma de Accionistas CONSA
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Forzar HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Bloquear carpetas y archivos internos
  RewriteRule ^(app|storage)(/|$) - [F,L]
  RewriteRule ^(config\.php|\.user\.ini|.*\.sql|.*\.md)$ - [F,L]
</IfModule>

<FilesMatch "^(config\.php|\.user\.ini)$">
  Require all denied
</FilesMatch>
